    {
      "id": "_ywwz_CtZIWSp99dU_mD4",
      "type": "text",
      "x": 740.7025951375557,
      "y": 699.6550483060174,
      "width": 722.897812590283,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
