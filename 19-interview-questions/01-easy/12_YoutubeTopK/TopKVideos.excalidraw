      "link": null,
      "locked": false,
      "text": "- subscribed only to topics\nwith comments from video\nthat your client are watching\n- viewer from same video end\nup on same server based on\nlayer 7 load banaler. it\nleverages consistent hashing. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- subscribed only to topics with comments from video that your client are watching\n- viewer from same video end up on same server based on layer 7 load banaler. it leverages consistent hashing. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
