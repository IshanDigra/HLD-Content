    {
      "id": "_ywwz_CtZIWSp99dU_mD4",
      "type": "text",
      "x": 747.0829782668019,
      "y": 418.91819061918704,
      "width": 722.897812590283,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6o",
