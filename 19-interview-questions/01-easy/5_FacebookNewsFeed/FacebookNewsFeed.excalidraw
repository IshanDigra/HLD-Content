    {
      "id": "bPc6MyMQc4M7trwOtrXxQ",
      "type": "text",
      "x": 625.1862913869581,
      "y": 2942.8061058163876,
      "width": 732.2638363039475,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 1319876784,
      "version": 3664,
      "versionNonce": 1546609522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1764651337755,
      "link": null,
      "locked": false,
      "text": "1) Handling users who follow Larger number of users\n    - Lots of computation for loading the feed on the go. \n    - Solution: Precomputed feed\n2) Handling users having large following \n    - the above solution creates issue for precomputing. \n    Solution A: We use a queue based mechanism and use asynchronous\nworkers to to push feeds to precompute feeds. Works for above as well. \n    - Better Solution: We flag the celebrities and for them we skip the pre\ncomputation part i.e when they post we don't update their followers\nprecomputed feeds. Instead we use Fan out read(Pull) model and merge\nwith the precomputed feed. \n3) Frequent reading from Post table for hot posts: \n    - Cache ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Handling users who follow Larger number of users\n    - Lots of computation for loading the feed on the go. \n    - Solution: Precomputed feed\n2) Handling users having large following \n    - the above solution creates issue for precomputing. \n    Solution A: We use a queue based mechanism and use asynchronous workers to to push feeds to precompute feeds. Works for above as well. \n    - Better Solution: We flag the celebrities and for them we skip the pre computation part i.e when they post we don't update their followers precomputed feeds. Instead we use Fan out read(Pull) model and merge with the precomputed feed. \n3) Frequent reading from Post table for hot posts: \n    - Cache ",
      "autoResize": false,
      "lineHeight": 1.25
    },
