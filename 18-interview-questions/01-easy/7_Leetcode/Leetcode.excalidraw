      "seed": 408070254,
      "version": 1330,
      "versionNonce": 355917184,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1765337821046,
      "link": null,
      "locked": false,
      "text": "4) API Design \n\nGET/problems?difficulty={difficulty}&topic={topic}&page={page}&limit={\nlimit} -------we will need pagination for this API\n    Output: 2xx, { Partial<Problem[]> }\n\nGET/problems/:problemId?language={language}\n    Output: 2xx, {problem}\n\nPOST/problems/submit\n    header: JWT passed for userId \n    Input: {code, language}\n    Output: 2xx, {Submission}\n\nGET/contest/:contestId/leaderboard?page={page}&limit={limit}\n    Output: 2xx, {leaderboard}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4) API Design \n\nGET/problems?difficulty={difficulty}&topic={topic}&page={page}&limit={limit} -------we will need pagination for this API\n    Output: 2xx, { Partial<Problem[]> }\n\nGET/problems/:problemId?language={language}\n    Output: 2xx, {problem}\n\nPOST/problems/submit\n    header: JWT passed for userId \n    Input: {code, language}\n    Output: 2xx, {Submission}\n\nGET/contest/:contestId/leaderboard?page={page}&limit={limit}\n    Output: 2xx, {leaderboard}",
      "autoResize": false,
      "lineHeight": 1.25
    },
