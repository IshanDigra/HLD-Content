    {
      "id": "Jz8DHzYff3heHD4o5_HxO",
      "type": "text",
      "x": 1537.4361562643721,
      "y": 502.42725755153424,
      "width": 606.424072265625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
