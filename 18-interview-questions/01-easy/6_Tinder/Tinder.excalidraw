      "link": null,
      "locked": false,
      "text": "Key Concepts on the go \n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key Concepts on the go \n",
