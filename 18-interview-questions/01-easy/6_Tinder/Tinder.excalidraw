    {
      "id": "HSqc5H8eZJNjarL9VIP-z",
      "type": "text",
      "x": 743.8032582010206,
      "y": 78.57912279027028,
      "width": 709.3511824996663,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
