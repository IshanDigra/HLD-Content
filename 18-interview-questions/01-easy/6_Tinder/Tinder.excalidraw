    },
    {
      "id": "Y3jegDnt_wNByJWdgpEyA",
      "type": "text",
      "x": 1534.8735038074678,
      "y": 73.88425248426364,
      "width": 824.6423705826081,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 526339248,
      "version": 7180,
      "versionNonce": 1646566784,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765108737192,
      "link": null,
      "locked": false,
      "text": "1) 1 sql server can handle upto 10k operations, noSql can handle around 100k\noperations \n2) For the case of swipes and cache use we need distributed transaction\nmanagement, Hence, we use SAGA Pattern to enforce consistent transaction in\ndistributed system.\n3) How to ensure no repeated profiles are shown: we could use bloom filters as well\napart from a simple index being used. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) 1 sql server can handle upto 10k operations, noSql can handle around 100k operations \n2) For the case of swipes and cache use we need distributed transaction management, Hence, we use SAGA Pattern to enforce consistent transaction in distributed system.\n3) How to ensure no repeated profiles are shown: we could use bloom filters as well apart from a simple index being used. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
