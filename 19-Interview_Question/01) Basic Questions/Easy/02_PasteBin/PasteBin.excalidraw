    {
      "id": "o8p1LH90FA07OsazVtcYV",
      "type": "text",
      "x": 1528.2206093823459,
      "y": 109.60384874179556,
      "width": 745.1612577027756,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#da77f2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
