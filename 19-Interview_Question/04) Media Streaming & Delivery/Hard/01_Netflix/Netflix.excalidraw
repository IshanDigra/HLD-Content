    {
      "id": "3NpR-EDjW1gkOQZVnkex2",
      "type": "text",
      "x": -386.52845646020353,
      "y": 1928.6782874914225,
      "width": 770.9084738017215,
      "height": 1039.018838288776,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
