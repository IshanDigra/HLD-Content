      "updated": 1766655067887,
      "link": null,
      "locked": false,
      "text": "4) API Design \n\nPOST/video/upload \n    Input: {videoMetadata, video} \n    Output: 2xx, success\n\nGET/video/:videoId \n    Output: {videoMetadata, video} ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4) API Design \n\nPOST/video/upload \n    Input: {videoMetadata, video} \n    Output: 2xx, success\n\nGET/video/:videoId \n    Output: {videoMetadata, video} ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Km1NZVmnIh-ujNqLOcpVA",
      "type": "text",
      "x": 1269.1412808335726,
