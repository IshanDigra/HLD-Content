    {
      "id": "o8p1LH90FA07OsazVtcYV",
      "type": "text",
      "x": 1571.3882070146678,
      "y": 495.1556310327212,
      "width": 745.1612577027756,
      "height": 1175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#da77f2",
