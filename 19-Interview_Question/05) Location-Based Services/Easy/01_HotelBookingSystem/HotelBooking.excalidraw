    {
      "id": "HSqc5H8eZJNjarL9VIP-z",
      "type": "text",
      "x": 208.68136394652527,
      "y": -363.7155110483207,
      "width": 709.3511824996663,
      "height": 2825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
