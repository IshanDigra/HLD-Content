    {
      "id": "_ywwz_CtZIWSp99dU_mD4",
      "type": "text",
      "x": 732.9613459228719,
      "y": 348.84958848951317,
      "width": 722.897812590283,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6o",
      "roundness": null,
      "seed": 1423259250,
      "version": 2713,
      "versionNonce": 710804653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766239370634,
      "link": null,
      "locked": false,
      "text": "2) Non Functional Requirements (SPARCS):  \n- Scalability: Millions of viewers per video\n- Latency: (<200ms) real time\n- Throughput: 1M rps should be taken care of\n- Availability >> Consistency\n\n------ out of scope ---------\n- Should ensure only authorized users can comment\n- Should enforce integrity constraints, ensuring comments are appropriate\n\n3) Core Entities \n- User  \n- Comment  \n- Live Video  \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Non Functional Requirements (SPARCS):  \n- Scalability: Millions of viewers per video\n- Latency: (<200ms) real time\n- Throughput: 1M rps should be taken care of\n- Availability >> Consistency\n\n------ out of scope ---------\n- Should ensure only authorized users can comment\n- Should enforce integrity constraints, ensuring comments are appropriate\n\n3) Core Entities \n- User  \n- Comment  \n- Live Video  \n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "A2P4AILlBEj0BXizHjARR",
      "type": "text",
      "x": 729.5055313922073,
      "y": 720.9801657457475,
      "width": 725.6259140844274,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6q",
      "roundness": null,
      "seed": 408070254,
      "version": 1880,
      "versionNonce": 1966043075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766240706170,
      "link": null,
      "locked": false,
      "text": "4) API Design \n\nPOST /comments\n    Input: (videoId, message)\n    Output: 2xx\n\nGET/comments/:videoIdcursor{last_comment_id}&pageSize=10&sort=desc\n    Output: {partial<comment[]>}\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4) API Design \n\nPOST /comments\n    Input: (videoId, message)\n    Output: 2xx\n\nGET/comments/:videoIdcursor{last_comment_id}&pageSize=10&sort=desc\n    Output: {partial<comment[]>}\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
