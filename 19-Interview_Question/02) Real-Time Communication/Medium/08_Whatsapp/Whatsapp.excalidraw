    {
      "id": "HSqc5H8eZJNjarL9VIP-z",
      "type": "text",
      "x": 735.9577519108863,
      "y": 79.88670717195936,
      "width": 709.3511824996663,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1106172592,
      "version": 7232,
      "versionNonce": 194993536,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1765472672859,
      "link": null,
      "locked": false,
      "text": "1) Functional Requirements:  \n- create a chat group \n- Send and receive messages \n- send and receive media files \n- receive message after being offline. \n\n--- bonus ----\n- Last seen\n- online/offline \n\n-- out of scope ---- \n- video & audio calling: must do this in future \n- Profile creation, status messages, channels\n- old messages scrolling and everything. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Functional Requirements:  \n- create a chat group \n- Send and receive messages \n- send and receive media files \n- receive message after being offline. \n\n--- bonus ----\n- Last seen\n- online/offline \n\n-- out of scope ---- \n- video & audio calling: must do this in future \n- Profile creation, status messages, channels\n- old messages scrolling and everything. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "b3QeLqnLHsxkexeN17H12",
      "type": "text",
      "x": 1534.6118253264783,
      "y": 31.35333855103812,
      "width": 336.19598388671875,
      "height": 70,
