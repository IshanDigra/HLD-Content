    {
      "id": "Y3jegDnt_wNByJWdgpEyA",
      "type": "text",
      "x": -432.1545836017176,
      "y": 529.6560013092026,
      "width": 770.9084738017215,
      "height": 886.9673009782233,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
