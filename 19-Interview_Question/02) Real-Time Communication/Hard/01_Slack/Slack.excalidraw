    {
      "id": "HSqc5H8eZJNjarL9VIP-z",
      "type": "text",
      "x": 740.5740364775842,
      "y": 50.66332878700956,
      "width": 709.3511824996663,
      "height": 2200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1106172592,
      "version": 8539,
