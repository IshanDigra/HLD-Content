    {
      "id": "o8p1LH90FA07OsazVtcYV",
      "type": "text",
      "x": 1578.1355358755668,
      "y": 1860.7228964905566,
      "width": 745.1612577027756,
      "height": 1200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#da77f2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
