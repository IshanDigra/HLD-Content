    {
      "id": "nRZ97kOuSGG6Z7kpzO9iK",
      "type": "text",
      "x": 258.36176793662344,
      "y": 39.044489362901004,
      "width": 1883.795654296875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQ1",
      "roundness": null,
      "seed": 1310644061,
      "version": 435,
      "versionNonce": 296002749,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781435528936,
      "link": null,
      "locked": false,
      "text": "A web crawler is a program that automatically traverses the web by downloading web pages and following links from one page to another. It is used to index the web for search engines, collect\ndata for research, or monitor websites for changes.\n\nQuestions to ask: \n- what is the type of webcrawler\ndesign a web crawler whose goal is to extract text data from the web to train an LLM.\nYour crawler can run for only 5 days.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A web crawler is a program that automatically traverses the web by downloading web pages and following links from one page to another. It is used to index the web for search engines, collect data for research, or monitor websites for changes.\n\nQuestions to ask: \n- what is the type of webcrawler\ndesign a web crawler whose goal is to extract text data from the web to train an LLM.\nYour crawler can run for only 5 days.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3l3B22jVKTzOzRxzUcwts",
