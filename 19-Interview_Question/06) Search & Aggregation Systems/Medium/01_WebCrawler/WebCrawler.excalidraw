    {
      "id": "x32tWLP4h02yTMRWhAQ9-",
      "type": "text",
      "x": 1125.074658561624,
      "y": 405.9027482914729,
      "width": 11.199999809265137,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
