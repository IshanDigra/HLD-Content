    {
      "id": "ituYJj5hdFK0VHwybOCfi",
      "type": "text",
      "x": 237.9967600278477,
      "y": 1327.666989669732,
      "width": 1044.8728331643492,
      "height": 2264.1924932430315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
