    },
    {
      "id": "rHSVCxVhVGEHHeUd6Q9a8",
      "type": "text",
      "x": 262.70261797845427,
      "y": 269.9612834793455,
      "width": 89.18000030517578,
      "height": 35,
      "angle": 0,
