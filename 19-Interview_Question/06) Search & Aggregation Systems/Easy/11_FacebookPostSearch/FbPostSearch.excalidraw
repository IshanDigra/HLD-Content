    },
    {
      "id": "o8p1LH90FA07OsazVtcYV",
      "type": "text",
      "x": 1539.8405433698238,
      "y": 71.16284025961522,
      "width": 745.1612577027756,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#da77f2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBZ",
      "roundness": null,
      "seed": 1041999971,
      "version": 617,
      "versionNonce": 977899651,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766342652853,
      "link": null,
      "locked": false,
      "text": "1) Latency: For low latency we add a cache to the system for search with a\nttl of around 1min. Apart from this we add a cdn\n\n2) ThroughPut: So since our system is very write intesive we need to take\ncare of the high vol of writes. We introduce a kafka before the ingestion\nservice where we push our writes and the ingestion service can subscribe to\nthe topics. For the case of likes we identify that a single increment in like\nwont be of that much impact to the sorting order. One of the way is to\nbatch the likes.\n\n3) Taking care of the storage: system is indexing an impressive amount of\ndata, but our users are likely only interested in a vanishingly small portion\nof it.\n- We won't need all 10M posts with \"Mark\" contained somewhere in their\ncontents. By keeping our indexes to 1k-10k items, we can reduce the\nnecessary storage by orders of magnitude.\n- most keywords won't be searched often or even at all. Based on our\nsearch analytics, we can run a batch job to move rarely used keywords to a\nless frequently accessed but ultimately cheaper storage like S3 or R2. When\nthe index needs to be queried, we'll first try to query Redis. If we don't\nget our keyword there, we can query the index from our blob storage with a\nsmall latency penalty.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Latency: For low latency we add a cache to the system for search with a ttl of around 1min. Apart from this we add a cdn\n\n2) ThroughPut: So since our system is very write intesive we need to take care of the high vol of writes. We introduce a kafka before the ingestion service where we push our writes and the ingestion service can subscribe to the topics. For the case of likes we identify that a single increment in like wont be of that much impact to the sorting order. One of the way is to batch the likes.\n\n3) Taking care of the storage: system is indexing an impressive amount of data, but our users are likely only interested in a vanishingly small portion of it.\n- We won't need all 10M posts with \"Mark\" contained somewhere in their contents. By keeping our indexes to 1k-10k items, we can reduce the necessary storage by orders of magnitude.\n- most keywords won't be searched often or even at all. Based on our search analytics, we can run a batch job to move rarely used keywords to a less frequently accessed but ultimately cheaper storage like S3 or R2. When the index needs to be queried, we'll first try to query Redis. If we don't get our keyword there, we can query the index from our blob storage with a small latency penalty.",
      "autoResize": false,
      "lineHeight": 1.25
    },
