  "elements": [
    {
      "id": "HSqc5H8eZJNjarL9VIP-z",
      "type": "text",
      "x": 735.9577519108863,
      "y": 79.88670717195936,
      "width": 709.3511824996663,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1106172592,
      "version": 7691,
      "versionNonce": 1075077677,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766342386057,
      "link": null,
      "locked": false,
      "text": "1) Functional Requirements:  \n- create and like posts\n- search posts based on keyword\n- get search results sorted by recency or like count\n\n----- out of scope ---------\n- Support fuzzy matching on terms (e.g. search for \"bird\" matches\n\"ostrich\").\n- Personalized search results(depending on details of the user)\n- privacy rules and filters\n- Sophisticated relevance algorithms for ranking.\n- Images and media.\n- Realtime updates to the search page as new posts come in.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Functional Requirements:  \n- create and like posts\n- search posts based on keyword\n- get search results sorted by recency or like count\n\n----- out of scope ---------\n- Support fuzzy matching on terms (e.g. search for \"bird\" matches \"ostrich\").\n- Personalized search results(depending on details of the user)\n- privacy rules and filters\n- Sophisticated relevance algorithms for ranking.\n- Images and media.\n- Realtime updates to the search page as new posts come in.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "b3QeLqnLHsxkexeN17H12",
      "type": "text",
      "x": 1536.3882548199135,
