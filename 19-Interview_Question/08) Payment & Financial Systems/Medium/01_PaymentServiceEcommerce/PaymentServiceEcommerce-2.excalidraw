    {
      "id": "ituYJj5hdFK0VHwybOCfi",
      "type": "text",
      "x": 1282.5768839022528,
      "y": 507.67866757173886,
      "width": 942.7627873861902,
      "height": 3676.269532039761,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eebefa",
      "fillStyle": "solid",
